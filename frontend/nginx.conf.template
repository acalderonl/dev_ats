# nginx sirve los estáticos y además hace de proxy hacia el backend.
#
# Por qué el proxy y no llamar a la API directamente desde el navegador:
#
# 1. **Vite incrusta las variables VITE_* al compilar**, no las lee al arrancar. Si el
#    navegador llamara a `https://api.ejemplo.com` habría que conocer esa dirección al
#    construir la imagen, y cambiarla obligaría a reconstruir.
# 2. Con el proxy todo sale del mismo origen, así que **no hay CORS**: ni cabeceras que
#    ajustar, ni peticiones de comprobación, ni un fallo silencioso el día que cambie
#    el dominio.
#
# El frontend se compila con `VITE_API_BASE_URL=/api/v1` (su valor por defecto) y
# `API_URL` apunta aquí a la dirección interna del backend.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Todo lo que empiece por /api va al backend tal cual.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Sin esta cabecera el backend vería todas las peticiones viniendo del proxy y
        # el límite por IP del portal público se aplicaría a todo el mundo junto.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Subir un CV puede tardar: el servidor lee el archivo y se lo manda a Claude.
        proxy_read_timeout 180s;
        client_max_body_size 20m;
    }

    # Los nombres de los ficheros compilados llevan un hash, así que su contenido nunca
    # cambia: se pueden guardar para siempre. `index.html` no, o el navegador seguiría
    # pidiendo la versión vieja tras cada despliegue.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # La aplicación resuelve sus rutas en el navegador (react-router). Sin esto, entrar
    # directo a /cargos o recargar daría un 404 de nginx: ese fichero no existe.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    server_tokens off;
}
