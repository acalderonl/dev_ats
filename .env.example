# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore:
# nunca se sube. Este ejemplo sí, así que aquí no va ningún secreto real.

# PostgreSQL
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=ats_db

# Backend
#
# SECRET_KEY firma los JWT. No tiene valor por defecto: si falta, la aplicación no
# arranca. Genera el tuyo y no lo compartas:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# De esta clave se deriva además el cifrado de los secretos que guardas desde la
# pantalla de Configuración (LinkedIn, Gmail). Si la cambias, esos secretos dejan de
# poder descifrarse y hay que volver a introducirlos.
SECRET_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# LinkedIn y Gmail NO van aquí: se configuran desde la pantalla de Configuración
# de la aplicación y se guardan cifrados en la base de datos.

# --- Solo para despliegue ---
#
# 'desarrollo' o 'produccion'. En produccion el seed NO crea las cuentas de demo
# (su contraseña está publicada en este repositorio) ni los cargos de ejemplo.
ENTORNO=desarrollo

# El primer administrador de un despliegue limpio. Solo se usan si la base no tiene
# ningún usuario; después, los usuarios se administran desde la aplicación.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
