# Variables del servidor. Se copia a `.env.produccion` EN LA MÁQUINA y se rellena allí.
#
# 🔴 `.env.produccion` está en .gitignore y nunca debe subirse: lleva las contraseñas
# reales. Este fichero de ejemplo sí se versiona, así que aquí no va ningún valor.
#
#     cp .env.produccion.example .env.produccion
#     nano .env.produccion

# El nombre al que apunta tu DNS. Caddy pide el certificado para este dominio, así que
# tiene que resolver a la IP de esta máquina ANTES de levantar.
DOMINIO=ats.tudominio.com

# --- Base de datos ---
# La contraseña no sale de aquí: la base no publica puertos. Aun así, genérala larga:
#     openssl rand -base64 32
POSTGRES_USER=ats
POSTGRES_PASSWORD=
POSTGRES_DB=ats

# --- Aplicación ---
# Firma los JWT y de ella se deriva el cifrado de las credenciales que guardes desde la
# pantalla de Configuración. Genérala con:
#     openssl rand -base64 48
#
# ⚠️ Si la cambias: se cierran todas las sesiones y hay que volver a introducir las
# credenciales de LinkedIn y del correo.
SECRET_KEY=

# --- Primer administrador ---
# Solo se usan si la base no tiene NINGÚN usuario. En el primer arranque crean tu
# cuenta; después puedes borrar estas dos líneas, ya no hacen nada.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
